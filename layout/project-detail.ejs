<%
page.banner_img_height = 0;
var project = page.project;
var hasLinks = project.github || project.demo || project.download;
var scope = project.scope || [];
var process = project.process || [];
var relatedProjects = page.relatedProjects || [];
var challenge = process.find(function(item) { return /问题|挑战|难点/.test(item.title || ''); });
var solution = process.find(function(item) { return /解决|应对|优化/.test(item.title || ''); });
var nextStep = process.find(function(item) { return /后续|下一步|计划/.test(item.title || ''); });
var caseNumber = String(page.projectIndex || 1).padStart(2, '0');
var mediaOrientation = project.media_orientation === 'portrait' ? 'portrait' : 'landscape';
var mediaRatio = project.media_ratio || '16 / 9';
%>
<article class="portfolio-shell project-detail">
  <nav class="project-breadcrumb material-control" aria-label="面包屑">
    <a href="<%= url_for('/projects/') %>">← 全部项目</a><span>/</span><strong><%= project.name %></strong>
  </nav>
  <header class="project-detail__hero">
    <div class="project-detail__intro">
      <p class="project-detail__chapter">CASE STUDY / <%= caseNumber %></p>
      <div class="project-card__meta"><span class="project-status project-status--<%= project.status %>"><span></span><%= project.status %></span><span class="project-type"><%= project.category.join(' / ') %></span></div>
      <h1><%= project.name %></h1>
      <p><%= project.description %></p>
      <div class="tag-list"><% project.tech.forEach(function(tag) { %><span><%= tag %></span><% }) %></div>
      <% if (project.role || project.outcome) { %>
        <dl class="project-detail__facts">
          <% if (project.role) { %><div><dt>我的角色</dt><dd><%= project.role %></dd></div><% } %>
          <% if (project.outcome) { %><div><dt>当前成果</dt><dd><%= project.outcome %></dd></div><% } %>
        </dl>
      <% } %>
      <% if (hasLinks) { %>
        <div class="portfolio-actions project-links">
          <% if (project.demo) { %><a class="portfolio-button portfolio-button--primary" href="<%= project.demo %>" target="_blank" rel="noopener" data-pressable>在线体验 ↗</a><% } %>
          <% if (project.github) { %><a class="portfolio-button portfolio-button--secondary" href="<%= project.github %>" target="_blank" rel="noopener" data-pressable>GitHub ↗</a><% } %>
          <% if (project.download) { %><a class="portfolio-button portfolio-button--secondary" href="<%= project.download %>" data-pressable>下载</a><% } %>
        </div>
      <% } %>
    </div>
    <div class="project-detail__visual project-detail__visual--<%= mediaOrientation %>" data-float-card><%- partial('_partials/portfolio/project-visual', { project: project }) %></div>
  </header>

  <section class="case-summary" aria-label="项目摘要">
    <article><span>01 / PROBLEM</span><h2>要解决的问题</h2><p><%= project.why %></p></article>
    <article><span>02 / APPROACH</span><h2>采用的方向</h2><p><%= project.decision || (solution && solution.text) || project.intro %></p></article>
    <article class="case-summary__result"><span>03 / OUTCOME</span><h2>已经做到</h2><p><%= project.outcome || project.description %></p></article>
  </section>

  <div class="project-detail__layout">
    <div class="project-detail__content">
      <section id="overview"><p class="section-label">01 / OVERVIEW</p><h2>项目全貌</h2><div class="project-overview"><p><%= project.intro %></p><div class="project-overview__scope"><span>WORK SCOPE</span><ul><% scope.forEach(function(item) { %><li><%= item %></li><% }) %></ul></div></div></section>

      <% if (challenge || solution) { %>
        <section id="challenge"><p class="section-label">02 / CHALLENGE</p><h2>挑战与解法</h2><div class="challenge-grid">
          <article><span>THE CHALLENGE</span><h3><%= challenge ? challenge.title : '核心问题' %></h3><p><%= challenge ? challenge.text : project.why %></p></article>
          <article class="challenge-grid__solution"><span>THE RESPONSE</span><h3><%= solution ? solution.title : '产品方向' %></h3><p><%= solution ? solution.text : (project.decision || project.intro) %></p></article>
        </div></section>
      <% } %>

      <section id="features"><p class="section-label">03 / FEATURES</p><h2>核心能力</h2><ul class="feature-list"><% project.features.forEach(function(feature, index) { %><li><span><%= String(index + 1).padStart(2, '0') %></span><strong><%= feature %></strong></li><% }) %></ul></section>

      <% if (project.decision) { %><section id="decision" class="decision-section"><p class="section-label">04 / DECISION</p><h2>关键产品判断</h2><blockquote><span>DESIGN PRINCIPLE</span><p><%= project.decision %></p></blockquote></section><% } %>

      <section id="gallery">
        <p class="section-label">05 / PRODUCT</p><h2><%= project.screenshots.length > 0 ? '运行界面' : '产品结构' %></h2>
        <% if (project.screenshots.length > 0) { %>
          <div class="screenshot-grid <%= project.screenshots.length === 1 ? 'screenshot-grid--single' : '' %>">
            <% project.screenshots.forEach(function(image, index) { %><button class="screenshot-button screenshot-button--<%= mediaOrientation %>" style="--project-media-ratio: <%= mediaRatio %>" type="button" data-lightbox-image="<%= url_for(image) %>" data-lightbox-alt="<%= project.name %> 截图 <%= index + 1 %>" data-pressable><img src="<%= url_for(image) %>" alt="<%= project.name %> 截图 <%= index + 1 %>" loading="lazy"></button><% }) %>
          </div>
        <% } else { %>
          <div class="product-architecture">
            <div class="product-architecture__head"><span>CORE FLOW</span><p>围绕 <%= scope.length %> 个核心模块组织产品，从需求入口一路连接到可验证的结果。</p></div>
            <ol><% scope.forEach(function(item, index) { %><li><span><%= String(index + 1).padStart(2, '0') %></span><strong><%= item %></strong><i aria-hidden="true">→</i></li><% }) %></ol>
          </div>
        <% } %>
      </section>

      <section id="process"><p class="section-label">06 / PROCESS</p><h2>从想法到落地</h2><div class="process-list"><% process.forEach(function(item, index) { %><article><span><%= String(index + 1).padStart(2, '0') %></span><div><h3><%= item.title %></h3><p><%= item.text %></p></div></article><% }) %></div></section>

      <% if (nextStep) { %><section id="next"><p class="section-label">07 / NEXT</p><h2>下一步</h2><div class="next-step"><span>WHAT'S NEXT</span><p><%= nextStep.text %></p></div></section><% } %>
    </div>
    <aside class="project-detail__aside material-panel">
      <div><span>TYPE</span><strong><%= project.category.join(' · ') %></strong></div>
      <div><span>STATUS</span><strong><%= project.status %></strong></div>
      <% if (project.role) { %><div><span>ROLE</span><strong><%= project.role %></strong></div><% } %>
      <% if (project.scope && project.scope.length) { %><div><span>SCOPE</span><strong><%= project.scope.join(' · ') %></strong></div><% } %>
      <div><span>STACK</span><strong><%= project.tech.join(' · ') %></strong></div>
      <nav class="project-detail__nav" aria-label="本页目录">
        <span>ON THIS PAGE</span>
        <a href="#overview" data-case-nav>项目全貌</a>
        <% if (challenge || solution) { %><a href="#challenge" data-case-nav>挑战与解法</a><% } %>
        <a href="#features" data-case-nav>核心能力</a>
        <% if (project.decision) { %><a href="#decision" data-case-nav>产品判断</a><% } %>
        <a href="#gallery" data-case-nav><%= project.screenshots.length > 0 ? '运行界面' : '产品结构' %></a>
        <a href="#process" data-case-nav>开发过程</a>
        <% if (nextStep) { %><a href="#next" data-case-nav>下一步</a><% } %>
      </nav>
      <a class="text-link" href="<%= url_for('/projects/') %>">← 返回全部项目</a>
    </aside>
  </div>

  <% if (relatedProjects.length) { %>
    <section class="related-projects" aria-labelledby="related-projects-title">
      <div class="related-projects__heading"><div><p class="section-label">KEEP EXPLORING</p><h2 id="related-projects-title">继续看看</h2></div><a class="text-link" href="<%= url_for('/projects/') %>">全部项目 <span aria-hidden="true">→</span></a></div>
      <div class="related-project-grid"><% relatedProjects.forEach(function(item, index) { %><%- partial('_partials/portfolio/project-card', { project: item, featured: false, index: index }) %><% }) %></div>
    </section>
  <% } %>
</article>

<div class="portfolio-lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="项目截图大图">
  <div class="portfolio-lightbox__surface" data-lightbox-surface>
    <button type="button" data-lightbox-close aria-label="关闭大图" data-pressable>×</button>
    <img alt="">
  </div>
</div>
