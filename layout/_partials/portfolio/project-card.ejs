<%
var detailUrl = url_for('/projects/' + project.slug + '/');
var filters = project_filter_group(project);
var techList = (project.tech || []).slice(0, featured ? 4 : 5);
var cardIndex = typeof index === 'number' ? String(index + 1).padStart(2, '0') : '';
%>
<article class="project-card <%= featured ? 'project-card--featured' : '' %>" data-project-card data-groups="<%= filters %>" data-float-card>
  <a class="project-card__visual-link" href="<%= detailUrl %>" aria-label="查看 <%= project.name %> 项目详情">
    <%- partial('project-visual', { project: project }) %>
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="project-status project-status--<%= project.status %>"><span></span><%= project.status %></span>
      <span class="project-type"><%= cardIndex || (project.category || []).join(' / ') %></span>
    </div>
    <h3><a href="<%= detailUrl %>"><%= project.name %></a></h3>
    <p><%= project.description %></p>
    <div class="tag-list" aria-label="技术栈">
      <% techList.forEach(function(tag) { %><span><%= tag %></span><% }) %>
    </div>
    <div class="project-card__links">
      <a class="text-link" href="<%= detailUrl %>">查看项目 <span aria-hidden="true">→</span></a>
      <% if (project.github) { %><a class="text-link project-card__github" href="<%= project.github %>" target="_blank" rel="noopener" aria-label="在 GitHub 查看 <%= project.name %>">GitHub <span aria-hidden="true">↗</span></a><% } %>
    </div>
  </div>
</article>
